---
// Fonts are self-hosted rather than pulled from the Google Fonts CDN: no
// third-party DNS/TLS in front of first paint, and no visitor IPs handed to
// Google. Both are variable fonts, so one file each covers every weight.
// Note the family names are 'Syne Variable' / 'JetBrains Mono Variable'
// (Fontsource convention) — see --display and --mono in global.css.
/* Preloaded by URL, not just imported. Without these the critical path is serial:
   HTML, then CSS, then the browser discovers the fonts and fetches them, so the
   first paint of a page whose hero is one giant word waits on a third round trip.
   Only the latin subsets are preloaded; the rest stay gated behind unicode-range and
   are never fetched for this content. ?url gives the hashed build path. */
import syneLatin from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '@fontsource-variable/syne/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { profile, links } from '../data/site';
import Chrome from '../components/Chrome.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;

/* Person schema. Search engines use this to treat the site as an entity rather than
   just a page, which is the whole point for a personal site. Built from site.ts so the
   name, role and links cannot drift from what the page renders. It is not executed as
   JavaScript, the MIME type is not a JS type, so it costs no parse or execute time. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${profile.first} ${profile.last}`,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: Astro.site?.href ?? 'https://1nurav.github.io/',
  description,
  worksFor: { '@type': 'Organization', name: 'SpeakUp' },
  sameAs: links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
};

// Canonical and Open Graph both require absolute URLs. Built from the current
// pathname rather than bare Astro.site, which would point every future page at
// the root and quietly de-duplicate them into the homepage.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={syneLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin="anonymous" />

    <meta name="theme-color" content="#08080a" />

    <!-- ICO first for browsers that ignore SVG icons, then the SVG they prefer:
         both are declared because no single format covers everything. The
         apple-touch-icon is the photo rather than the monogram, since iOS
         renders it at 180px where a face is actually legible. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="canonical" href={pageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Varun Babu, Lead Software Engineer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <Chrome />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { init } from '../scripts/motion';
      init();
    </script>
  </body>
</html>
