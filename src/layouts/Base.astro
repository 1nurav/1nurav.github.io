---
// Fonts are self-hosted rather than pulled from the Google Fonts CDN: no
// third-party DNS/TLS in front of first paint, and no visitor IPs handed to
// Google. Both are variable fonts, so one file each covers every weight.
// Note the family names are 'Syne Variable' / 'JetBrains Mono Variable'
// (Fontsource convention) — see --display and --mono in global.css.
import '@fontsource-variable/syne/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Chrome from '../components/Chrome.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;

// Canonical and Open Graph both require absolute URLs. Built from the current
// pathname rather than bare Astro.site, which would point every future page at
// the root and quietly de-duplicate them into the homepage.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080a" />

    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Varun Babu, Team Lead" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <Chrome />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { init } from '../scripts/motion.js';
      init();
    </script>
  </body>
</html>
