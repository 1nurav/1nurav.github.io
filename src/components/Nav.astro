---
import { nav } from '../data/site.js';
---

<nav>
  {/* aria-label because `title` is not a reliable accessible name, and without it
      this announces as "VB v1.0, button", which says nothing about what it does. */}
  <button
    type="button"
    class="monogram"
    data-accent-toggle
    aria-label="Cycle accent colour"
    title="go on. click it."
  >
    {/* Hand-initialled VB, the way you'd sign off a review. It signs itself on
        load: V in the accent, then B. aria-hidden because the button's
        aria-label already names it, and the strokes are decorative. */}
    <svg class="sig" width="34" height="34" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <path class="sig-v" d="M3 7 C5 24 7 32 10 31 C13 30 13.5 15 16 8" pathLength="100" stroke-width="3.6" stroke-linecap="round" />
      <path class="sig-b" d="M21 6 C20 18 20 27 21 32 M21 9 C29 3.5 32.5 11 22 15.5 M22 15.5 C33 15 33.5 29 20.5 31.5" pathLength="100" stroke-width="3.4" stroke-linecap="round" />
    </svg>
  </button>

  <div class="links" id="nav-links">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>

  <div class="actions">
    <a class="cta" href="#contact">say hi</a>
    {/* Only rendered for narrow screens, where the section links collapse. aria-expanded
        and aria-controls carry the state, so it announces as a real disclosure rather
        than an unlabelled button. */}
    <button
      type="button"
      class="burger"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Sections"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 8000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px var(--gutter);
    /* No backdrop-filter. A backdrop blur has to re-sample and re-blur everything
       behind it every frame, and during scroll that content changes constantly, so it
       can never be cached. It was the main source of scroll jitter. The gradient below
       already keeps the bar legible over moving content. */
    background: linear-gradient(180deg, rgba(8, 8, 10, 0.86), rgba(8, 8, 10, 0.25));
    border-bottom: 1px solid rgb(var(--line-rgb) / 0.06);
  }

  .monogram {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }
  /* Inline rather than an <img> on purpose: the V is stroked with var(--acc), so
     the mark re-signs itself in whatever colour the accent cycling lands on. */
  .sig { display: block; overflow: visible; }
  .sig path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation-name: sign;
    animation-timing-function: ease;
    animation-fill-mode: forwards;
  }
  /* Written long-hand, and qualified with `path` to match the specificity of the
     rule above. The `animation` shorthand there resets animation-delay to 0, and
     `.sig path` (0,1,1) outranks a bare `.sig-v` (0,1,0), so the delays were being
     silently discarded and both letters drew at once. The V finishes at 1.0s and
     the B starts at 1.05s, so the hand never appears to write two strokes at once. */
  .sig path.sig-v {
    stroke: var(--acc);
    animation-duration: 0.75s;
    animation-delay: 0.25s;
  }
  .sig path.sig-b {
    stroke: var(--fg);
    animation-duration: 0.95s;
    animation-delay: 1.05s;
  }
  @keyframes sign {
    to { stroke-dashoffset: 0; }
  }
  /* The global reduced-motion rule only shortens durations, and a 0.001ms draw
     still finishes. Delays are not covered though, so clear them or the mark sits
     invisible for a second. */
  @media (prefers-reduced-motion: reduce) {
    .sig path { animation-delay: 0s !important; }
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 34px);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .links a { color: rgb(var(--fg-rgb) / 0.66); }
  .links a:hover { color: var(--acc); }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Hidden on desktop, where the links sit inline and need no disclosure. */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    /* 44px square: the guideline minimum, and the reason this is a button with
       padding rather than three bare lines. */
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .burger span {
    display: block;
    width: 20px;
    height: 1.5px;
    margin: 0 auto;
    background: var(--fg);
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  /* Into an X, so the button says what it will do next. */
  nav[data-open] .burger span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  nav[data-open] .burger span:nth-child(2) { opacity: 0; }
  nav[data-open] .burger span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .cta {
    padding: 9px 16px;
    border: 1px solid var(--acc);
    border-radius: 999px;
    color: var(--acc);
    transition: background 0.3s, color 0.3s;
  }
  .cta:hover {
    background: var(--acc);
    color: var(--bg);
  }

  @media (max-width: 720px) {
    .burger { display: flex; }

    /* The links become a panel under the bar instead of vanishing. nav is already
       position: fixed, so absolute positioning here anchors to it. */
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 4px var(--gutter) 14px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      font-size: 12px;
    }
    nav[data-open] .links { display: flex; }
    /* Generous rows: a 12px link needs padding to reach a usable tap target. */
    .links a {
      padding: 15px 0;
      border-bottom: 1px solid rgb(var(--line-rgb) / 0.06);
    }
    .links a:last-child { border-bottom: 0; }

    /* Both of these were under 44px tall: 94x27 and 85x35. */
    .monogram { padding: 6px 4px; }
    .cta { padding: 13px 18px; }
  }
</style>
