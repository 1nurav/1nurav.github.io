---
import { profile } from '../data/site.js';

const solid = profile.first.split('');
const outline = profile.last.split('');
---

<header>
  <div class="status">
    <span class="pulse"></span>
    <span>{profile.role}</span>
    <span class="sep">/</span>
    <span data-clock>--:--:--</span>
    <span class="sep">/</span>
    <span data-zone>local</span>
  </div>

  <h1 class="name">
    <span class="word">
      {solid.map((c) => <span data-kin>{c}</span>)}
    </span>
    <span class="word outline">
      {outline.map((c) => <span data-kin>{c}</span>)}
    </span>
  </h1>

  {/* Stewards' bulletin. Loiter on the hero and you get investigated. Hidden until
      motion.js decides you have been idle, and aria-live so it is announced rather
      than appearing silently for anyone not looking at it. */}
  <div class="penalty" data-penalty role="status" aria-live="polite"></div>

  <div class="foot">
    <p class="intro" data-reveal>{profile.intro}</p>
    <div class="scroll" data-reveal>
      <span class="spinner"></span>
      <span>scroll, obviously</span>
    </div>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 2;
    /* svh is the viewport with mobile browser chrome *showing*. Plain vh measures
       it with the URL bar collapsed, so the hero overflowed on load and the page
       shifted as the bar hid. vh first as the fallback for anything without svh. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(110px, 14vh, 150px) var(--gutter) clamp(30px, 6vh, 56px);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 26px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--fg-rgb) / 0.5);
  }
  .sep { color: rgb(var(--fg-rgb) / 0.24); }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acc);
    animation: blink 1.4s infinite;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0 clamp(16px, 2.4vw, 40px);
    font-family: var(--display);
    font-weight: 800;
    /* Floor is 46px, not 58px: below ~465px the 12.5vw term drops under the
       floor, so the floor wins and stops scaling. At 360px, a very common
       Android width, 58px made the widest word 353px inside a 324px box and
       pushed 11px of horizontal scroll onto the whole page. 46px still fits at
       320px, measured, so it holds down to the narrowest screens in use. */
    font-size: clamp(46px, 12.5vw, 196px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    user-select: none;
  }
  .word {
    display: flex;
    gap: 0.012em;
  }
  .word span {
    display: inline-block;
    will-change: transform;
  }
  .outline {
    gap: 0.05em;
    padding-right: 0.06em;
    color: transparent;
    -webkit-text-stroke: 2px var(--acc);
  }

  /* Stewards' bulletin: a document, not a toast. Mono, uppercase, hairline border,
     the way an FIA note looks. Whole rule blocks only. */
  .penalty {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(96px, 15vh, 170px);
    z-index: 20;
    max-width: min(340px, calc(100vw - 36px));
    padding: 12px 15px;
    border: 1px solid rgb(255 93 58 / 0.45);
    border-radius: var(--radius);
    background: rgb(16 16 19 / 0.96);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.55);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.7;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ff5d3a;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .penalty.on {
    opacity: 1;
    transform: translateY(0);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 34px;
    margin-top: clamp(34px, 6vw, 72px);
  }
  .intro {
    max-width: 44ch;
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.65;
    color: var(--fg-70);
  }
  .scroll {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--fg-rgb) / 0.42);
  }
  .spinner {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgb(var(--fg-rgb) / 0.2);
    border-top-color: var(--acc);
    animation: spin 2.6s linear infinite;
  }
</style>
