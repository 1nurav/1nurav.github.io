---
import { profile } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <span>&#169; {year} {profile.first} {profile.last}</span>
  <span>hand-built, no templates, mild sleep deprivation</span>
    {/* Same joke, told correctly for the input device: a phone has no V to press,
        though the monogram is tappable either way. Swapped in CSS, not JS, so it
        reads right with JS off, and data-egg stays on the wrapper so the accent
        cycle still overwrites the whole line. */}
    <span data-egg>
      <span class="egg-key">press "v" if you're bored</span>
      <span class="egg-tap">tap the VB if you're bored</span>
    </span>
</footer>

<style>
  footer {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 26px var(--gutter);
    border-top: 1px solid var(--line-soft);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--fg-rgb) / 0.38);
  }
  .egg-tap { display: none; }
  @media (hover: none) {
    .egg-key { display: none; }
    .egg-tap { display: inline; }
  }
</style>
