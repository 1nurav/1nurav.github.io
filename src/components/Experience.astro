---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site.js';
---

<section id="experience" class="section">
  <div class="head">
    <SectionHeading index="03" label="experience" title="Seven years, four logos" />
    <div class="total" data-reveal>
      <span class="figure">7</span>
      <span class="label">years since 15 jul 2019</span>
    </div>
  </div>

  <div class="rows">
    {experience.map((job) => (
      <div class="row" data-reveal>
        <div class="period">{job.period}</div>
        <h3>{job.company}</h3>
        <div class="note">{job.note}</div>
        <div class:list={['duration', { current: job.current }]}>
          {job.current && <span class="pulse"></span>}
          <span>{job.duration}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 70px);
  }
  .total {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .figure {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(46px, 6vw, 84px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--acc);
  }
  .total .label { max-width: 16ch; }

  .rows { border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .row {
    display: grid;
    grid-template-columns: minmax(140px, 0.55fr) minmax(200px, 1.4fr) minmax(150px, 0.9fr) auto;
    align-items: center;
    gap: clamp(14px, 3vw, 40px);
    padding: clamp(20px, 2.6vw, 34px) 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.35s, padding-left 0.35s;
  }
  .row:hover {
    /* Derived from --acc so it follows the accent cycling. */
    background: color-mix(in oklab, var(--acc) 5%, transparent);
    padding-left: 22px;
  }

  .period {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-50);
  }
  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .note {
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg-70);
  }
  .duration {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(241, 241, 236, 0.38);
  }
  .duration.current { color: var(--acc); }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acc);
    animation: blink 1.4s infinite;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr auto;
      row-gap: 8px;
    }
    h3 { grid-column: 1 / -1; }
    .note { grid-column: 1 / -1; }
  }
</style>
