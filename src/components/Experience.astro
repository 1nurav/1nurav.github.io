---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site.js';
---

<section id="experience" class="section">
  <div class="head">
    <SectionHeading index="03" label="experience" title="Seven years, four logos" />
    <div class="total" data-reveal>
      <span class="figure">7</span>
      <span class="label">years since jul 2019</span>
    </div>
  </div>

  <div class="rows">
    {experience.map((job) => (
      <div class="row" data-reveal>
        <div class="period">{job.period}</div>
        <div class="company">
          {/* alt="" on purpose: the company name sits right beside it in the h3,
              so announcing the mark too would just read the name twice. */}
          {job.logo && <img class="logo" src={job.logo} alt="" loading="lazy" decoding="async" />}
          <h3>{job.company}</h3>
        </div>
        <div class="note">{job.note}</div>
        <div class:list={['duration', { current: job.current }]}>
          {job.current && <span class="pulse"></span>}
          <span>{job.duration}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 70px);
  }
  .total {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .figure {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(46px, 6vw, 84px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--acc);
  }
  .total .label { max-width: 16ch; }

  .rows { border-top: 1px solid rgb(var(--line-rgb) / 0.1); }
  .row {
    display: grid;
    /* Every track has to be fixed or pure-fr. Each .row is its own grid, so an
       auto track, or a minmax whose min beats its fr share, sizes to that row's
       own content and the columns stop lining up between rows. The last track
       was auto and the durations differ ("present" vs "2 yrs 2 mos"), which
       pushed .duration to 999/1024/985/985 across the four rows. */
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.4fr) minmax(0, 0.9fr) 112px;
    align-items: center;
    gap: clamp(14px, 3vw, 40px);
    padding: clamp(20px, 2.6vw, 34px) 8px;
    border-bottom: 1px solid rgb(var(--line-rgb) / 0.1);
    transition: background 0.35s, padding-left 0.35s;
  }
  .row:hover {
    /* Derived from --acc so it follows the accent cycling. */
    background: color-mix(in oklab, var(--acc) 5%, transparent);
    padding-left: 22px;
  }

  .period {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-50);
  }
  .company {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.4vw, 18px);
  }
  /* No filter and no backing plate: each file is already dark-background ready,
     so brand colour survives untouched. Navex keeps its #FF4500 and
     PeopleInTouch its blue, both of which clear 3:1 on --bg unaided. SpeakUp
     keeps its #00b68d mark with only the neutral wordmark lifted, and
     GlobalLogic is monochrome so it carries no hue to lose. See the README in
     public/assets/logos. Height is capped rather than width: the marks run from
     a square glyph to a 4.4:1 wordmark. */
  .logo {
    height: clamp(18px, 2vw, 26px);
    width: auto;
    max-width: 92px;
    object-fit: contain;
  }

  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .note {
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg-70);
  }
  .duration {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--fg-rgb) / 0.38);
  }
  .duration.current { color: var(--acc); }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acc);
    animation: blink 1.4s infinite;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr auto;
      row-gap: 8px;
    }
    /* .company now wraps the h3, so it is the grid child that has to span. */
    .company { grid-column: 1 / -1; }
    .note { grid-column: 1 / -1; }
  }
</style>
