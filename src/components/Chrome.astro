---
// Fixed overlays: film grain, sector timing strip, custom cursor, cursor aura.
---

<div class="grain" data-grain></div>

{/* Timing strip. Three sectors, because a lap has three, each one a third of the
    scroll. A sector fills as you read it and locks when you leave: green once set,
    purple for the quickest of the visit. Reads as a plain progress bar to anyone
    who does not follow the sport. */}
<div class="progress-track" data-sectors aria-hidden="true">
  <div class="sector"><div class="sector-fill"></div></div>
  <div class="sector"><div class="sector-fill"></div></div>
  <div class="sector"><div class="sector-fill"></div></div>
</div>

<div class="cursor-ring" data-cursor-ring></div>
<div class="cursor-dot" data-cursor-dot></div>
<div class="aura" data-aura></div>

<style>
  /* inset was -50%, making this 200% x 200% of the viewport, so the compositor
     re-blended four viewports' worth of `overlay` on every animation step, three
     times a second, forever. The keyframes only translate by 6% of the element's
     own size, so -10% is all the bleed needed to keep an edge from showing: same
     look, roughly a third of the blend area. */
  .grain {
    position: fixed;
    inset: -10%;
    z-index: 9000;
    pointer-events: none;
    opacity: 0.4;
    background-image: url('/assets/grain.svg');
    animation: grain 1.1s steps(3) infinite;
    mix-blend-mode: overlay;
  }

  .progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 9100;
    display: flex;
    /* Sector widths track how much page each one occupies, set from motion.js, so
       the strip is a map of the document rather than four equal quarters. */
    gap: 2px;
    background: rgb(var(--line-rgb) / 0.06);
  }
  .sector {
    position: relative;
    flex: 1 1 0;
    overflow: hidden;
  }
  .sector-fill {
    height: 100%;
    width: 0;
    background: var(--acc);
    box-shadow: 0 0 18px var(--acc);
    transition: background 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  /* Real timing-screen semantics, and they move: yellow for a sector slower than
     your own best, green when you beat it, purple for the quickest of the three.
     Scroll back up and read a stretch faster and the colours re-sort live. These
     are literal signal colours from the sport, so unlike everything else here they
     stay put while --acc cycles: a green that could turn orange means nothing. */
  .sector.t-slow .sector-fill {
    background: #ffd23f;
    box-shadow: 0 0 12px rgb(255 210 63 / 0.45);
  }
  .sector.t-pb .sector-fill {
    background: #00d26a;
    box-shadow: 0 0 14px rgb(0 210 106 / 0.55);
  }
  .sector.t-best .sector-fill {
    background: #b14ff5;
    box-shadow: 0 0 16px rgb(177 79 245 / 0.6);
  }

  .cursor-ring,
  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    border-radius: 50%;
  }
  .cursor-ring {
    width: 42px;
    height: 42px;
    margin: -21px 0 0 -21px;
    border: 1px solid var(--acc);
    z-index: 9200;
    mix-blend-mode: difference;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--acc);
    z-index: 9201;
  }

  .aura {
    position: fixed;
    top: 0;
    left: 0;
    width: 900px;
    height: 900px;
    margin: -450px 0 0 -450px;
    z-index: 0;
    pointer-events: none;
    filter: blur(30px);
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--acc) 12%, transparent) 0%,
      transparent 62%
    );
  }

  /* Both cases skip the pointer loop in motion.js, so nothing ever moves these.
     The aura in particular has no resting opacity and would sit as a static glow
     bleeding out of the top-left corner. */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .cursor-ring,
    .cursor-dot,
    .aura { display: none; }
  }
</style>
