---
import { marquee } from '../data/site.js';

// Track is duplicated so the -50% translate loops seamlessly.
const track = [...marquee, ...marquee];

// Scroll speed, not scroll duration, is the thing to hold steady: the -50%
// translate covers exactly one copy of the list, so a fixed duration makes
// longer copy race past. Character count stands in for rendered width, which is
// rough with a proportional face but close enough at this size. The ratio is
// anchored to the original list: 73 units took 22s, so that is the reference
// speed. Edit `marquee` freely and the timing follows.
const units = marquee.join('').length + marquee.length;
const duration = Math.round((units / 73) * 22);
---

{/* Decorative. The list is duplicated for the loop and padded with asterisks, so
    a screen reader would otherwise read "estimates are fiction, star, no deploys
    on friday, star..." and then the whole thing a second time. */}
<div class="strip" aria-hidden="true" style={'--marquee-duration:' + duration + 's'}>
  <div class="track">
    <span class="run">
      {track.map((word) => (
        <Fragment>
          <span>{word}</span>
          <span>*</span>
        </Fragment>
      ))}
    </span>
  </div>
</div>

<style>
  .strip {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding: 16px 0;
    background: var(--acc);
    color: var(--bg);
    border-top: 1px solid rgb(var(--line-rgb) / 0.08);
    border-bottom: 1px solid rgb(var(--line-rgb) / 0.08);
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration, 22s) linear infinite;
  }
  .run {
    display: flex;
    gap: 34px;
    padding-right: 34px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 38px);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
</style>
