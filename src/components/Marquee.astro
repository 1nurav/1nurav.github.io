---
import { marquee } from '../data/site.js';

// Track is duplicated so the -50% translate loops seamlessly.
const track = [...marquee, ...marquee];

// Scroll speed, not scroll duration, is the thing to hold steady: the -50%
// translate covers exactly one copy of the list, so a fixed duration makes
// longer copy race past. Character count stands in for rendered width, which is
// rough with a proportional face but close enough at this size. The ratio is
// anchored to the original list: 73 units took 22s, so that is the reference
// speed. Edit `marquee` freely and the timing follows.
const units = marquee.join('').length + marquee.length;
const duration = Math.round((units / 73) * 22);
---

{/* Decorative. The list is duplicated for the loop and padded with asterisks, so
    a screen reader would otherwise read "estimates are fiction, star, no deploys
    on friday, star..." and then the whole thing a second time. */}
<div class="strip" aria-hidden="true" style={'--marquee-duration:' + duration + 's'}>
  <div class="track">
    <span class="run">
      {track.map((word) => (
        <Fragment>
          <span>{word}</span>
          <span>*</span>
        </Fragment>
      ))}
    </span>
  </div>
</div>

<style>
  .strip {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding: 20px 0;
    background: var(--acc);
    color: var(--bg);
  }
  /* Kerbs. The accent band stays, since it is what breaks up a very dark page, and
     the track read comes from the edges instead: slanted red and white striping, top
     and bottom, exactly where a kerb sits either side of a circuit. Angled at 115deg
     because real kerbs are cut on a diagonal, not square.

     Signal colours, so they hold still while --acc cycles: kerbs are not team livery.
     A whole rule block, and the 1px borders it replaces are removed below. */
  .strip::before,
  .strip::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 6px;
    z-index: 1;
    background: repeating-linear-gradient(
      115deg,
      #e10600 0 13px,
      #f1f1ec 13px 26px
    );
  }
  .strip::before { top: 0; }
  .strip::after { bottom: 0; }

  .track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration, 22s) linear infinite;
  }
  .run {
    display: flex;
    gap: 34px;
    padding-right: 34px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 38px);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
</style>
