---
import SectionHeading from './SectionHeading.astro';
import { links, profile } from '../data/site.js';
---

<section id="contact" class="section">
  <SectionHeading index="05" label="contact" />

  <a class="email" href={'mailto:' + profile.email} data-reveal>{profile.email}</a>

  <div class="pills">
    {links.map((link) => (
      <a
        class="pill"
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : null}
        rel={link.href.startsWith('http') ? 'noopener' : null}
        data-reveal
      >
        <span>{link.label}</span>
        <span>&#8599;</span>
      </a>
    ))}
  </div>
</section>

<style>
  section {
    padding-block: clamp(80px, 12vw, 170px) clamp(40px, 6vw, 70px);
  }
  section :global(.eyebrow) { margin-bottom: 30px; }

  .email {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 7.2vw, 118px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    word-break: break-word;
  }
  .email:hover { color: var(--acc); }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(34px, 5vw, 60px);
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .pill:hover {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--bg);
  }
</style>
