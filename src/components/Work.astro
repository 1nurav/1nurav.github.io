---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site.js';
---

<section id="work" class="section">
  <div class="head">
    <SectionHeading index="04" label="selected work" title="Three slots, awaiting glory" />
    <p class="aside" data-reveal>
      Placeholders below. Send the project names and one line each and they become real.
    </p>
  </div>

  <div class="grid-auto">
    {projects.map((project) => (
      <article class="card project" data-reveal>
        {project.image
          ? <img class="shot" src={project.image} alt={project.title} />
          : <div class="shot placeholder"><span class="label">[ project shot ]</span></div>}
        <div class="meta">
          <h3>{project.title}</h3>
          <span class="year">{project.year}</span>
        </div>
        <p>{project.body}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
  }
  .aside {
    max-width: 34ch;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(241, 241, 236, 0.5);
  }

  .project { padding: 18px; }
  .shot {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
  }
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
  }
  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .year {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--acc);
  }
  .project p {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(241, 241, 236, 0.55);
  }
</style>
