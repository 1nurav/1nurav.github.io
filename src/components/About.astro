---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { profile, stats } from '../data/site.js';
---

<section id="about" class="section about">
  <div>
    <SectionHeading index="01" label="about" title={profile.headline} />
    {profile.bio.map((para) => <p class="prose" data-reveal>{para}</p>)}
  </div>

  <div class="side">
    <div class="stats" data-reveal>
      {stats.map((stat) => (
        <div class="stat">
          <div class:list={['value', { accent: stat.accent, small: stat.small }]}>{stat.value}</div>
          <div class="label">{stat.label}</div>
        </div>
      ))}
    </div>

    <figure class="photo" data-reveal>
      <Image
        src={profile.photo.src}
        alt={profile.photo.alt}
        widths={[480, 760, 900, 1200, 1800]}
        sizes="(max-width: 760px) 92vw, (max-width: 1200px) 46vw, 900px"
        format="webp"
        quality={75}
        style={'object-position:' + profile.photo.position}
      />
      <figcaption>
        <span>the guy in question</span>
        <span class="hint">hover me</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(40px, 6vw, 90px);
    padding-block: clamp(80px, 12vw, 180px);
  }
  .about :global(.title) { margin-bottom: 28px; }
  .prose + .prose { margin-top: 18px; }

  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .stat {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .value {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1;
  }
  .value.small {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.05;
  }
  .value.accent { color: var(--acc); }
  .stat .label { margin-top: 10px; }

  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    animation: float 7s ease-in-out infinite;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.6s ease, transform 0.6s var(--ease);
  }
  .photo:hover img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.04);
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(8, 8, 10, 0.82) 100%);
    pointer-events: none;
  }
  figcaption {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--fg-rgb) / 0.62);
    pointer-events: none;
  }
  .hint { color: var(--acc); }
</style>
