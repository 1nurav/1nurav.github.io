---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { profile, stats } from '../data/site.js';
---

<section id="about" class="section about">
  <div>
    <SectionHeading index="01" label="about" title={profile.headline} />
    {profile.bio.map((para) => <p class="prose" data-reveal>{para}</p>)}
  </div>

  <div class="side">
    <div class="stats" data-reveal>
      {stats.map((stat) => (
        <div class="stat">
          <div class:list={['value', { accent: stat.accent, small: stat.small }]}>{stat.value}</div>
          <div class="label">{stat.label}</div>
        </div>
      ))}
    </div>

    {/* loading/decoding explicit rather than inherited from Astro's default: this is
        the largest asset on the page and it sits below the fold. */}
    <figure class="photo" data-reveal>
      <Image
        src={profile.photo.src}
        alt={profile.photo.alt}
        widths={[480, 760, 900, 1200, 1800]}
        sizes="(max-width: 760px) 92vw, (max-width: 1200px) 46vw, 900px"
        format="webp"
        quality={75}
        style={'object-position:' + profile.photo.position}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span>the guy in question</span>
        <span class="hint">hover me</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .about {
    display: grid;
    /* min(320px, 100%), not a bare 320px: once the container is narrower than
       the track minimum, a bare min wins and overflows the page. That cost 18px
       of horizontal scroll at 320px. */
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(40px, 6vw, 90px);
    padding-block: clamp(80px, 12vw, 180px);
  }
  .about :global(.title) { margin-bottom: 28px; }
  .prose + .prose { margin-top: 18px; }

  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .stats {
    display: grid;
    /* minmax(0, 1fr), not 1fr: a bare fr is minmax(auto, 1fr), so the widest
       content sets its own column and the halves stop being halves. That split
       was 240/126 at 400px. Pinning the min to 0 costs the browser's implicit
       overflow protection, hence the single column below, and min-width on the
       tile so a long value can never bleed into its neighbour again. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
  }
  /* A word value ("SpeakUp") needs ~194px and a half tile offers ~134px on a
     phone. Shrinking it to fit would mean 18px beside 34px numbers, so the grid
     goes single-column instead, at the width where two stop fitting. */
  @media (max-width: 520px) {
    .stats { grid-template-columns: minmax(0, 1fr); }
  }
  .stat {
    min-width: 0;
    /* So .value can size against this tile rather than the viewport. */
    container-type: inline-size;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .value {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1;
  }
  /* Word values, not numbers. The cqw ceiling keeps the word inside its own
     tile whatever the tile is doing: viewport-based sizing cannot know that
     .side halves at wide widths, which is how "SpeakUp" ended up 60px wider
     than its box. 13cqw fits the longest value here; a much longer one would
     want its own tile rather than a bigger number. */
  .value.small {
    font-size: min(clamp(26px, 3vw, 38px), 13cqw);
    line-height: 1.05;
  }
  .value.accent { color: var(--acc); }
  .stat .label { margin-top: 10px; }

  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    animation: float 7s ease-in-out infinite;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.6s ease, transform 0.6s var(--ease);
  }
  .photo:hover img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.04);
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(8, 8, 10, 0.82) 100%);
    pointer-events: none;
  }
  figcaption {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--fg-rgb) / 0.62);
    pointer-events: none;
  }
  .hint { color: var(--acc); }
</style>
